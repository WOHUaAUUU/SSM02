<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ssy.com.mapper.OrdersMapper">
<!--    注意type需要写类的全路径名字，select必须要写resultType或resultMap-->
<resultMap id="orderRes" type="ssy.com.pojo.Orders">
    <id  column="order_id" property="orderId"/>
    <result  column="order_name" property="orderName"/>
    <association property="customer" javaType="ssy.com.pojo.Customer">
        <id column="customer_id" property="customerId" />
        <result  column="customer_name" property="customerName"/>
    </association>
</resultMap>
    <select id="selectOrderAndCustomer" resultMap="orderRes">
        select order_id,order_name,t_customer.customer_id,customer_name
        from t_orders join t_customer on t_orders.customer_id = t_customer.customer_id
        where t_orders.order_id=#{orderId}
    </select>
</mapper>