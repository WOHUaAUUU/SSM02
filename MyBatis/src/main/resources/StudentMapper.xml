<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ssy.com.mapper.StudentMapper">
    <resultMap id="studentResMap" type="ssy.com.pojo.Student">
        <id property="sId" column="s_id"/>
        <result column="s_name" property="sName"/>
        <collection property="teachers" ofType="ssy.com.pojo.Teacher">
            <id property="tId" column="t_id"/>
            <result column="t_name" property="tName"/>
        </collection>
    </resultMap>
    <select id="selectAllStudentsAndTeacher" resultMap="studentResMap">
        select t_student.s_id, t_student.s_name,  t_teacher.t_id, t_teacher.t_name
        from t_student join t_inner on t_student.s_id=t_inner.s_id join t_teacher on t_inner.t_id=t_teacher.t_id
    </select>
</mapper>